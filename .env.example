# ──────────────────────────────────────────────
# KidsVerse — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to `.env.local` (development) or set in Vercel Dashboard (production).

# ── Firebase Configuration ──
# Obtain these from: Firebase Console > Project Settings > Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Stripe Configuration ──
# Obtain from: Stripe Dashboard > Developers > API Keys
# Use pk_test_* for development, pk_live_* for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App Configuration ──
# VITE_APP_URL: Set to your Vercel deployment URL for production
#   e.g. https://kidsverse.vercel.app or your custom domain
VITE_APP_URL=http://localhost:3000
VITE_MAX_CHILD_PROFILES=5
VITE_FREE_TIER_MINUTES_PER_DAY=30
VITE_PREMIUM_TIER_MINUTES_PER_DAY=120

# ── YouTube API (for approved video playlists) ──
# Obtain from: Google Cloud Console > APIs & Services > Credentials
# Enable "YouTube Data API v3" before use
VITE_YOUTUBE_API_KEY=your_youtube_api_key
